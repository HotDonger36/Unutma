<?xml version="1.0" encoding="utf-8"?>
<!-- Next event: how long until it starts, then its name and time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_cn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_cn_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/geist_semibold"
        android:letterSpacing="0.1"
        android:text="NEXT EVENT"
        android:textColor="#8A8A8A"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_cn_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_light"
            android:includeFontPadding="false"
            android:textColor="#79BAFF"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/w_cn_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/geist_mono_regular"
            android:textColor="#79BAFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_cn_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/geist_medium"
        android:maxLines="2"
        android:textColor="#EDEDED"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/w_cn_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/geist_mono_regular"
        android:maxLines="1"
        android:textColor="#8A8A8A"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>