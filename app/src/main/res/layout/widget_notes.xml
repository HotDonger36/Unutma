<?xml version="1.0" encoding="utf-8"?>
<!-- Notes widget: several notes as cards you can scroll, and a + button for a new note. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ListView
            android:id="@+id/w_ns_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="70dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/w_ns_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/geist_mono_regular"
            android:gravity="center"
            android:text="No notes yet"
            android:textColor="#8A8A8A"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- The + button floats over the bottom-right of the list. -->
    <FrameLayout
        android:id="@+id/w_ns_fab"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="New note">

        <ImageView
            android:id="@+id/w_ns_fab_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/w_fab" />

        <ImageView
            android:id="@+id/w_ns_fab_plus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/ic_w_plus" />
    </FrameLayout>
</FrameLayout>
