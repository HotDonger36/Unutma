<?xml version="1.0" encoding="utf-8"?>
<!-- One event in the Agenda widget, with a day heading above it when a new day starts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_cai_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/w_cai_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:fontFamily="@font/geist_semibold"
        android:letterSpacing="0.1"
        android:textColor="#6E6E6E"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_cai_time"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_regular"
            android:maxLines="1"
            android:textColor="#8A8A8A"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/w_cai_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/w_cai_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/geist_regular"
            android:maxLines="1"
            android:textColor="#EDEDED"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
